# TimeboardApp (Docker Compose)

# GHCR image and immutable release tag used by docker-compose.yml.
TIMEBOARDAPP_IMAGE=ghcr.io/paulkakell/timeboardapp
TIMEBOARDAPP_TAG=00.13.00

# Host port to publish the app on.
PORT=8888

# Host directory for persistent data. This directory will contain settings.yml and the SQLite database.
CONFIG_DATA=./data

# Unique container name and Docker network alias for this stack.
# Production and demo stacks on the same proxy network must use different values.
CONTAINER_NAME=timeboardapp

# External Docker network names. Compose expects these networks to exist.
INTERNAL_NETWORK=net_internal
EXTERNAL_NETWORK=net_external

# Optional timezone and UID/GID mapping.
TZ=America/Denver
PUID=1000
PGID=1000
